# Azure Bot registration (Bot Framework)
MicrosoftAppType=SingleTenant
MicrosoftAppId=
MicrosoftAppPassword=
MicrosoftAppTenantId=
PORT=3978
# Required: comma-separated Entra ID (AAD) object ids allowed to use the bot. Empty = nobody.
TEAMS_ALLOWED_AAD_IDS=

# Workday tenant (read by asor; the runner strips MicrosoftApp*/TEAMS_* before spawning it)
ASOR_TENANT=
ASOR_CLIENT_ID=
ASOR_CLIENT_SECRET=
# Workday rotates refresh tokens on every refresh, so keep it in a writable file (not a plain env var).
# Seed the file once with `asor login --authorize`, or copy the refreshToken from a saved profile.
ASOR_REFRESH_TOKEN_FILE=./.asor-refresh-token

# The agent this bot talks to (id or slug) — or a CLI generated with `asor wrap`
ASOR_DEFAULT_AGENT=
# ASOR_WRAPPED_BIN=/path/to/benefits-helper/bin/benefits-helper.js
