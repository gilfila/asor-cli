# Slack (Socket Mode)
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
# Required: comma-separated Slack user ids allowed to use the bot. Empty = nobody.
SLACK_ALLOWED_USER_IDS=U0123456789
# Optional: restrict to these channel ids
SLACK_ALLOWED_CHANNEL_IDS=

# Workday tenant (read by asor; the runner strips SLACK_* before spawning it)
ASOR_TENANT=
ASOR_CLIENT_ID=
ASOR_CLIENT_SECRET=
ASOR_REFRESH_TOKEN=
# ASOR_HOST=us.agent.workday.com

# Which agent answers @mentions (id or slug) — or pin a wrapped CLI instead
ASOR_DEFAULT_AGENT=
# ASOR_WRAPPED_BIN=/path/to/benefits-helper/bin/benefits-helper.js
