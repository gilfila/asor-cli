{
  "name": "asor-cli",
  "version": "0.1.0",
  "description": "Log into a Workday tenant, discover agents in the Agent System of Record (ASOR), and drive any of them from a CLI — so Slack bots, Teams bots, Claude Code, or cron can use them.",
  "type": "module",
  "license": "MIT",
  "author": "Tony Gilfillan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gilfila/asor-cli.git"
  },
  "homepage": "https://github.com/gilfila/asor-cli#readme",
  "bugs": "https://github.com/gilfila/asor-cli/issues",
  "keywords": [
    "workday",
    "asor",
    "agent-system-of-record",
    "a2a",
    "agents",
    "cli",
    "slack",
    "teams"
  ],
  "bin": {
    "asor": "dist/src/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "test": "npm run clean && npm run build && node --test \"dist/test/**/*.test.js\"",
    "mock": "npm run build && node dist/mock/server.js",
    "lint": "tsc -p tsconfig.json --noEmit",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
